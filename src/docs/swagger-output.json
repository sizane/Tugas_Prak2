  "definitions": {
    "StallInput": {
      "type": "object",
      "properties": {
        "ownerId": { "type": "number", "example": 2 },
        "name": { "type": "string", "example": "Warung Baru" },
        "category": { "type": "string", "example": "Nasi" },
        "location": { "type": "string", "example": "Kantin FK" },
        "description": { "type": "string", "example": "" }
      },
      "required": ["ownerId", "name"]
    },
    "UserInput": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "example": "John Doe" },
        "email": { "type": "string", "example": "john@example.com" },
        "password": { "type": "string", "example": "password123" },
        "role": { "type": "string", "example": "customer" }
      },
      "required": ["name", "email", "password"]
    },
    "MenuItemInput": {
      "type": "object",
      "properties": {
        "stallId": { "type": "number", "example": 1 },
        "name": { "type": "string", "example": "Nasi Goreng" },
        "price": { "type": "number", "example": 15000 },
        "isAvailable": { "type": "boolean", "example": true }
      },
      "required": ["stallId", "name", "price"]
    },
    "ReviewInput": {
      "type": "object",
      "properties": {
        "stallId": { "type": "number", "example": 1 },
        "userId": { "type": "number", "example": 1 },
        "rating": { "type": "number", "example": 5 },
        "comment": { "type": "string", "example": "Enak banget!" }
      },
      "required": ["stallId", "userId", "rating"]
    },
    "FlagStatusInput": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "example": "resolved" }
      },
      "required": ["status"]
    },
    "AuditLogInput": {
      "type": "object",
      "properties": {
        "userId": { "type": "number", "example": 1 },
        "action": { "type": "string", "example": "CREATE_USER" },
        "details": { "type": "string", "example": "Menambahkan user baru" }
      },
      "required": ["action"]
    },
    "LikeInput": {
      "type": "object",
      "properties": {
        "reviewId": { "type": "number", "example": 1 },
        "userId": { "type": "number", "example": 1 }
      },
      "required": ["reviewId", "userId"]
    }
  }
